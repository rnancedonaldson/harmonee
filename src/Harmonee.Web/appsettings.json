{
  "Authentication": {
    "Mode": "EntraExternalId"
  },
  "AzureAd": {
    "Instance": "https://<your-tenant-subdomain>.ciamlogin.com/",
    "TenantId": "<external-tenant-id>",
    "ClientId": "<web-app-registration-client-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "ClientCredentials": []
  },
  "HarmoneeApi": {
    "BaseAddress": "https+http://api",
    "Scopes": [ "api://<api-app-registration-client-id>/Harmonee.Access" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
