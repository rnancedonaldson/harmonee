@page "/families/{FamilyId:guid}/shopping"

<FamilyPage Family="Family" Problem="LoadProblem" Title="Shopping lists" RequiredPermission="FamilyPermission.ViewShoppingLists">
    @if (Family!.Can(FamilyPermission.ManageShoppingLists))
    {
        <section class="panel">
            <EditForm Model="Create" FormName="create-list" OnValidSubmit="CreateAsync" Enhance class="inline-form">
                <DataAnnotationsValidator />
                <ProblemAlert Problem="ActionProblem" />
                <label for="list-name" class="visually-hidden">New list name</label>
                <InputText id="list-name" @bind-Value="Create!.Name" placeholder="New list, e.g. Weekly groceries" />
                <button type="submit" class="btn btn-primary">Create list</button>
                <ValidationMessage For="() => Create!.Name" />
            </EditForm>
        </section>
    }

    <ProblemAlert Problem="_listProblem" />

    @if (_lists.Count == 0)
    {
        <p class="empty">No shopping lists yet.</p>
    }
    else
    {
        <ul class="card-grid" role="list">
            @foreach (var list in _lists)
            {
                <li class="card">
                    <a class="card-link" href="@FamilyUrl($"/shopping/{list.Id}")">
                        <h2>@list.Name</h2>
                        <p class="muted">@list.OpenItemCount to get · @list.ItemCount total</p>
                    </a>
                </li>
            }
        </ul>
        @if (_nextCursor is not null)
        {
            <p><a class="btn btn-ghost" href="@FamilyUrl($"/shopping?cursor={Uri.EscapeDataString(_nextCursor)}")">Older lists →</a></p>
        }
    }
</FamilyPage>

@code {
    private IReadOnlyList<ShoppingListSummary> _lists = [];
    private string? _nextCursor;
    private ApiProblem? _listProblem;

    [SupplyParameterFromQuery(Name = "cursor")]
    private string? Cursor { get; set; }

    [SupplyParameterFromForm(FormName = "create-list")]
    private ShoppingListForm? Create { get; set; }

    protected override async Task LoadAsync()
    {
        Create ??= new();
        var result = await Api.ListShoppingListsAsync(FamilyId, Cursor, Aborted);
        _listProblem = result.Problem;
        _lists = result.Value?.Items ?? [];
        _nextCursor = result.Value?.NextCursor;
    }

    private async Task CreateAsync()
    {
        var created = await Api.CreateShoppingListAsync(FamilyId, new SaveShoppingListRequest(Create!.Name!.Trim()), Aborted);
        Complete(created.Problem, created.Value is { } list ? FamilyUrl($"/shopping/{list.Id}") : null);
    }
}
