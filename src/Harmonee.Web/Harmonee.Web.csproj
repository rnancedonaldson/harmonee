<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Harmonee web app: Blazor (static server rendering) and the browser's Backend-for-Frontend. Holds OIDC tokens server-side; the browser only gets an HTTP-only cookie.</Description>
    <UserSecretsId>harmonee-web-3e9d0b14</UserSecretsId>
    <ContainerRepository>harmonee-web</ContainerRepository>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Harmonee.ServiceDefaults\Harmonee.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Harmonee.Api.Contracts\Harmonee.Api.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Harmonee.Web.Tests" />
  </ItemGroup>
</Project>
